# Example only. Opt in by copying to ~/.config/systemd/user/ and enabling it yourself.
# Voice is paid: a running service starts a billed session whenever the owner joins the channel.
[Unit]
Description=Cataly Discord voice assistant (opt-in, paid)
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.cataly/config.json
ConditionPathExists=%h/.config/cataly/voice.env

[Service]
Type=simple
WorkingDirectory=%h
# Adjust PATH so it finds bun and your `cataly` command.
Environment=PATH=%h/.cataly/bin:%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Mode 0600: CATALY_DISCORD_TOKEN, CATALY_DISCORD_OWNER_ID and the key named by voice.apiKeyEnv.
EnvironmentFile=%h/.config/cataly/voice.env
ExecStart=/usr/bin/env cataly voice discord
# No automatic restart: a failure holds voice instead of retrying paid calls.
Restart=no
# Allow the 15-second socket close and bounded 60-second summary request to finish.
TimeoutStopSec=90
KillMode=control-group

[Install]
WantedBy=default.target
